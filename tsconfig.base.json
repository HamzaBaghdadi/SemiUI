{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "bundler",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2015",
    "module": "esnext",
    "lib": ["es2020", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "strict": false,
    "paths": {
      "@zaytoon/cli": ["./libs/cli/src/index.ts"],
      "@zaytoon/tokens": ["./libs/tokens/src/index.ts"],
      "@zaytoon/theme": ["./libs/theme/src/index.ts"],
      "@zaytoon/primitives": ["./libs/primitives/src/index.ts"],
      "@zaytoon/presets-aurora": ["./libs/presets/aurora/src/index.ts"],
      "@zaytoon/primitives/button": ["./libs/primitives/button/src/index.ts"],
      "@zaytoon/primitives/icon": ["./libs/primitives/icon/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
